{
  "name": "top-one-protocol",
  "version": "6.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "test": "node --import tsx --test lib/*.test.ts lib/adapters/*.test.ts",
    "test:mobile": "npm --prefix apps/mobile run typecheck && npm --prefix apps/mobile run test",
    "typecheck": "tsc --noEmit",
    "check:fast": "npm run typecheck && npm run test",
    "sync:app": "node scripts/sync-mobile-web.mjs",
    "test:database": "node --import tsx scripts/test-database.mts",
    "test:backup": "node --test scripts/encrypted-backup.test.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@libsql/client": "0.15.15",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@trpc/server": "11.0.0",
    "@vercel/og": "1.0.3",
    "drizzle-orm": "0.41.0",
    "framer-motion": "14.0.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^2.15.0",
    "superjson": "2.2.2",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@11.25.0"
}
