{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@/*": [
        "../*"
      ],
      "@/lib/supabaseClient": [
        "./src/platform/client.ts"
      ],
      "@/lib/emailAuth": [
        "./src/platform/emailAuth.ts"
      ],
      "next/navigation": [
        "./src/next/navigation.ts"
      ],
      "next/link": [
        "./src/next/link.tsx"
      ],
      "next/dynamic": [
        "./src/next/dynamic.tsx"
      ],
      "next/image": [
        "./src/next/image.tsx"
      ],
      "@/lib/appNavigation": [
        "./src/platform/appNavigation.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
