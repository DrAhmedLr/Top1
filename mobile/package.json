{
  "name": "top1-mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:native": "node scripts/prepare-native-assets.mjs",
    "sync": "pnpm prepare:native && pnpm build && cap sync",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "doctor": "node scripts/doctor.mjs",
    "check:submission": "node scripts/check-submission.mjs",
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check:bundle": "node --test scripts/check-bundle.test.mjs && node scripts/check-bundle.mjs",
    "check:client": "pnpm typecheck && pnpm build && pnpm check:bundle"
  },
  "dependencies": {
    "@capacitor/core": "8.6.2",
    "@capacitor/android": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@supabase/supabase-js": "2.117.3",
    "@capacitor/app": "8.0.0",
    "@capacitor/browser": "8.0.0",
    "@capacitor/filesystem": "8.0.0",
    "@capacitor/share": "8.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "vite": "7.3.1",
    "typescript": "5.9.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.19.7"
  }
}
